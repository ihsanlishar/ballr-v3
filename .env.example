FOOTBALL_DATA_API_KEY=replace-with-your-key
# Railway: attach a volume at /data and set BALLR_DB_PATH=/data/ballr.db
# BALLR_DB_PATH=/data/ballr.db
# Optional season start-year override; normally inferred with July rollover.
# FOOTBALL_SEASON=2026

# Optional safety limits (defaults shown; normally leave unchanged).
# BALLR_MAX_QUOTES=10000
# BALLR_DB_BUDGET_MB=256
# BALLR_DISK_RESERVE_MB=128
# Set a random token of at least 32 characters to enable authenticated backups.
# Never commit the real token. Use the same value in GitHub Actions secrets.
# BALLR_BACKUP_TOKEN=
